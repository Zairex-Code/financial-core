{
  "info": {
    "name": "Financial Core - Bank Core",
    "description": "Coleccion Postman para el Ecosistema Bancario Reactivo (customer, account, credit, transaction).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseCustomer", "value": "http://localhost:8081" },
    { "key": "baseAccount", "value": "http://localhost:8082" },
    { "key": "baseCredit", "value": "http://localhost:8083" },
    { "key": "baseTransaction", "value": "http://localhost:8084" },
    { "key": "customerId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "creditId", "value": "" }
  ],
  "item": [
    {
      "name": "customer-service",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseCustomer}}/api/v1/customers", "host": ["{{baseCustomer}}"], "path": ["api", "v1", "customers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentNumber\": \"12345678\",\n  \"documentType\": \"DNI\",\n  \"name\": \"Juan Perez\",\n  \"email\": \"juan.perez@gmail.com\",\n  \"phoneNumber\": \"+51999888777\",\n  \"type\": \"PERSONAL\",\n  \"profile\": \"STANDARD\"\n}"
            }
          }
        },
        {
          "name": "Get all customers",
          "request": { "method": "GET", "url": { "raw": "{{baseCustomer}}/api/v1/customers", "host": ["{{baseCustomer}}"], "path": ["api", "v1", "customers"] } }
        },
        {
          "name": "Get customer by id",
          "request": { "method": "GET", "url": { "raw": "{{baseCustomer}}/api/v1/customers/{{customerId}}", "host": ["{{baseCustomer}}"], "path": ["api", "v1", "customers", "{{customerId}}"] } }
        }
      ]
    },
    {
      "name": "account-service",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseAccount}}/api/v1/accounts", "host": ["{{baseAccount}}"], "path": ["api", "v1", "accounts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"type\": \"SAVINGS\",\n  \"balance\": 500.0\n}"
            }
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseAccount}}/api/v1/accounts/{{accountId}}/deposits", "host": ["{{baseAccount}}"], "path": ["api", "v1", "accounts", "{{accountId}}", "deposits"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100.0\n}" }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseAccount}}/api/v1/accounts/{{accountId}}/withdrawals", "host": ["{{baseAccount}}"], "path": ["api", "v1", "accounts", "{{accountId}}", "withdrawals"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50.0\n}" }
          }
        },
        {
          "name": "Get all accounts",
          "request": { "method": "GET", "url": { "raw": "{{baseAccount}}/api/v1/accounts", "host": ["{{baseAccount}}"], "path": ["api", "v1", "accounts"] } }
        }
      ]
    },
    {
      "name": "credit-service",
      "item": [
        {
          "name": "Create credit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseCredit}}/api/v1/credits", "host": ["{{baseCredit}}"], "path": ["api", "v1", "credits"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"type\": \"PERSONAL\",\n  \"amount\": 5000.0,\n  \"interestRate\": 12.5,\n  \"installmentCount\": 12\n}"
            }
          }
        },
        {
          "name": "Pay credit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseCredit}}/api/v1/credits/{{creditId}}/payments", "host": ["{{baseCredit}}"], "path": ["api", "v1", "credits", "{{creditId}}", "payments"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 500.0\n}" }
          }
        },
        {
          "name": "Consume credit card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseCredit}}/api/v1/credits/{{creditId}}/consumptions", "host": ["{{baseCredit}}"], "path": ["api", "v1", "credits", "{{creditId}}", "consumptions"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 300.0\n}" }
          }
        },
        {
          "name": "Get all credits",
          "request": { "method": "GET", "url": { "raw": "{{baseCredit}}/api/v1/credits", "host": ["{{baseCredit}}"], "path": ["api", "v1", "credits"] } }
        }
      ]
    },
    {
      "name": "transaction-service",
      "item": [
        {
          "name": "Get movements by product",
          "request": { "method": "GET", "url": { "raw": "{{baseTransaction}}/api/v1/movements/product/{{accountId}}", "host": ["{{baseTransaction}}"], "path": ["api", "v1", "movements", "product", "{{accountId}}"] } }
        },
        {
          "name": "Get latest 10 movements by product",
          "request": { "method": "GET", "url": { "raw": "{{baseTransaction}}/api/v1/movements/product/{{accountId}}/latest/10", "host": ["{{baseTransaction}}"], "path": ["api", "v1", "movements", "product", "{{accountId}}", "latest", "10"] } }
        }
      ]
    }
  ]
}
